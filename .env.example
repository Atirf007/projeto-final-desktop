# Banco de dados (variáveis obrigatórias)
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=nome_do_banco

# Usados por "npm run criar-admin"
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque_esta_senha

# Usados por "npm run criar-funcionario" (perfil instrutor)
FUNCIONARIO_NOME=Funcionario Cotil
FUNCIONARIO_EMAIL=funcionario@exemplo.com
FUNCIONARIO_SENHA=troque_esta_senha

# Envio de e-mails do bot de clima (Google Workspace UNICAMP/Cotil) — variáveis opcionais
# Todos os campos SMTP ficam comentados de propósito: sem eles o app funciona localmente
# e registra notificações internas em vez de tentar enviar e-mail com placeholders.
# Para habilitar, descomente e preencha TODOS os campos abaixo.

# Preencha SMTP_PASS com a senha de app de 16 caracteres (myaccount.google.com/apppasswords).
# Use a senha de app do Google, e não a senha normal da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# SMTP_USER=seu_email@exemplo.com
# SMTP_PASS=senha_de_app_de_16_caracteres
# Remetente usado nos avisos. Se vazio, o bot usa SMTP_USER.
# Aceita "email@exemplo.com" ou "Nome da academia <email@exemplo.com>".
# SMTP_FROM=seu_email@exemplo.com
# SMTP_REMETENTE_NOME=Academia Exemplo

# Destinatário do botão "Enviar e-mail de teste" da tela Gerenciar Bot
# SMTP_TESTE_DESTINATARIO=seu_email@exemplo.com

# Validação do certificado TLS do servidor SMTP (opcional).
# Use false somente em servidores com certificado autoassinado.
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Alternativa: relay interno da UNICAMP (funciona apenas dentro da rede da universidade)
# SMTP_HOST=smtp.unicamp.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Clima (opcionais)
# CLIMA_CIDADE=Limeira - SP
# CLIMA_LATITUDE=-22.5645
# CLIMA_LONGITUDE=-47.4017
# CLIMA_LIMIAR_CHUVA=50

# Agendamento automático do bot (opcional).
# Para desligar o agendamento em outro PC que rode o app, use:
# CLIMA_BOT_ATIVO=false
# Arquivo de estado do agendamento quando usado sem o Electron (opcional):
# CLIMA_BOT_CONFIG_ARQUIVO=/caminho/para/bot-clima-servidor.json

# Link de decisão do aluno enviado por e-mail (opcionais)
# CLIMA_DECISAO_HOST=127.0.0.1
# CLIMA_DECISAO_PORTA=39517
# Se o link for aberto fora deste computador, use a URL pública da máquina:
# CLIMA_DECISAO_URL_BASE=http://127.0.0.1:39517
# Usado pelo clima-servidor e pelos scripts de teste para guardar o segredo HMAC:
# CLIMA_DECISAO_ARQUIVO=/caminho/para/bot-clima-decisao.json
