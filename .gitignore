# mas mantém o modelo versionado .env.example.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs e cobertura de testes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# Sistema operacional e editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Temporários de merge/edição
*.tmp
*.bak
*.orig
*.rej

# Dumps e backups de banco (o schema versionado database/schema.sql é mantido)
*.dump
*.sql.gz
dump-*.sql
backup-*.sql
*-backup.sql
