{
  "name": "projeto-final-dad",
  "version": "1.0.0",
  "description": "Projeto final DAD",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "tsx scripts/garantir-electron.ts",
    "prestart": "tsx scripts/garantir-electron.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src','dist',{recursive:true,filter:(s)=>!s.endsWith('.ts')})\"",
    "typecheck": "tsc --noEmit",
    "criar-tabelas": "tsx scripts/criar-tabelas.ts",
    "criar-admin": "tsx scripts/criar-admin.ts",
    "criar-funcionario": "tsx scripts/criar-funcionario.ts",
    "start": "npm run build && electron .",
    "testar-email": "npm run build && tsx scripts/testar-email.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/nodemailer": "^8.0.2",
    "electron": "39.8.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
